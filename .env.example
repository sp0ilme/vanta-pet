# Consumer API key and secret from your X developer app
X_API_KEY=
X_API_SECRET=

# Must match a callback URL registered on the app (e.g. https://your-app.onrender.com/callback)
CALLBACK_URL=https://your-app.onrender.com/callback

# Used to sign session cookies. Generate a long random string for production.
SECRET_KEY=

# Optional: where the SQLite file is stored. Defaults to ./data/vanta.db
# DATA_DIR=./data
